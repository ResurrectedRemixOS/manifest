<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="rr"
           fetch="https://github.com/ResurrectedRemixOS/"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/rr-17.0" />

  <!-- vendor/lineage becomes vendor/rr. -->
  <remove-project name="LineageOS/android_vendor_lineage" path="vendor/lineage" />

  <remove-project name="LineageOS/android" path="android" />
  <remove-project name="LineageOS/android_packages_apps_Canvas" path="packages/apps/Canvas" />

  <!-- Drop the LineageOS definitions we replace. Paths redefined below. -->
  <remove-project name="LineageOS/android_art" path="art" />
  <remove-project name="LineageOS/android_bionic" path="bionic" />
  <remove-project name="LineageOS/android_bootable_recovery" path="bootable/recovery" />
  <remove-project name="LineageOS/android_build" path="build/make" />
  <remove-project name="LineageOS/android_build_soong" path="build/soong" />
  <remove-project name="LineageOS/android_device_google_car" path="device/google_car" />
  <remove-project name="LineageOS/android_device_lineage_sepolicy" path="device/lineage/sepolicy" />
  <remove-project name="LineageOS/android_frameworks_av" path="frameworks/av" />
  <remove-project name="LineageOS/android_frameworks_base" path="frameworks/base" />
  <remove-project name="LineageOS/android_frameworks_libs_systemui" path="frameworks/libs/systemui" />
  <remove-project name="LineageOS/android_frameworks_native" path="frameworks/native" />
  <remove-project name="LineageOS/android_frameworks_opt_telephony" path="frameworks/opt/telephony" />
  <remove-project name="LineageOS/android_lineage-sdk" path="lineage-sdk" />
  <remove-project name="LineageOS/scripts" path="lineage/scripts" />
  <remove-project name="LineageOS/android_system_media" path="system/media" />
  <remove-project name="LineageOS/android_system_sepolicy" path="system/sepolicy" />
  <remove-project name="platform/system/tools/aidl" path="system/tools/aidl" />
  <remove-project name="LineageOS/android_tools_extract-utils" path="tools/extract-utils" />
  <remove-project name="LineageOS/android_device_qcom_sepolicy_vndr" path="device/qcom/sepolicy_vndr/sm8750" />
  <remove-project name="LineageOS/android_hardware_qcom-caf_common" path="hardware/qcom-caf/common" />
  <remove-project name="LineageOS/android_hardware_qcom_audio-ar" path="hardware/qcom-caf/sm8750/audio/primary-hal" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-core" path="hardware/qcom-caf/sm8750/display/core" />
