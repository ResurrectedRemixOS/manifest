           groups="pdk,sysui-studio" />
  <project name="frameworks_opt_telephony" path="frameworks/opt/telephony" remote="rr"
           groups="pdk,sysui-studio" />
  <project name="lineage-sdk" path="lineage-sdk" remote="rr" />
  <project name="lineage_scripts" path="lineage/scripts" remote="rr" groups="tools" />
  <project name="system_media" path="system/media" remote="rr" groups="pdk" />
  <project name="system_sepolicy" path="system/sepolicy" remote="rr" groups="pdk" />
  <project name="system_tools_aidl" path="system/tools/aidl" remote="rr" groups="pdk" />
  <project name="tools_extract-utils" path="tools/extract-utils" remote="rr" />

  <!-- Qualcomm sm8750 -->
  <project name="device_qcom_sepolicy_vndr_sm8750" path="device/qcom/sepolicy_vndr/sm8750" remote="rr"
           groups="qcom,pakala-vendor" />
  <project name="hardware_qcom-caf_common" path="hardware/qcom-caf/common" remote="rr"
           groups="qcom">
    <!-- add guard for AOSP hardware/qcom dir -->
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <!-- add guards for CAF repositories -->
    <linkfile src="os_pickup_sepolicy_vndr.mk" dest="device/qcom/sepolicy_vndr/SEPolicy.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450-6.6/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8550/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8850/Android.bp" />
  </project>
  <project name="hardware_qcom-caf_sm8750_audio_primary-hal" path="hardware/qcom-caf/sm8750/audio/primary-hal" remote="rr"
           groups="qcom,pakala-audio" />
  <project name="hardware_qcom-caf_sm8750_display_core" path="hardware/qcom-caf/sm8750/display/core" remote="rr"
           groups="qcom" />
  <project name="hardware_qcom-caf_sm8750_display_hal" path="hardware/qcom-caf/sm8750/display/hal" remote="rr"
           groups="qcom" />
  <project name="hardware_qcom-caf_sm8750_display_intf" path="hardware/qcom-caf/sm8750/display/intf" remote="rr"
           groups="qcom" />

  <!-- Apps -->
  <project name="packages_apps_CarrierConfig" path="packages/apps/CarrierConfig" remote="rr"
           groups="pdk-cw-fs,pdk-fs" />
  <project name="packages_apps_Launcher3" path="packages/apps/Launcher3" remote="rr"
           groups="pdk-fs,sysui-studio,pdk-cw-tvc" />
  <project name="packages_apps_LineageParts" path="packages/apps/LineageParts" remote="rr" />
  <project name="packages_apps_Settings" path="packages/apps/Settings" remote="rr"
           groups="pdk-fs,pdk-cw-tvc,sysui-studio" />
  <project name="packages_apps_SetupWizard" path="packages/apps/SetupWizard" remote="rr" />
  <project name="packages_apps_Updater" path="packages/apps/Updater" remote="rr" />

  <!-- createjson.py reads vendor/OTA/<device>.json at build time for the device fields
       (oem, links, trees). -->
  <project name="OTA" path="vendor/OTA" remote="rr" revision="refs/heads/main" />

  <project name="packages_overlays_Lineage" path="packages/overlays/Lineage" remote="rr" />

  <!-- Replaces vendor/lineage, removed above. -->
  <project name="vendor_rr" path="vendor/rr" remote="rr" />

  <!-- Resurrected Remix -->
  <project name="packages_apps_BugReport" path="packages/apps/BugReport" remote="rr" />
  <project name="packages_apps_FaceUnlock" path="packages/apps/FaceUnlock" remote="rr" />
  <project name="packages_apps_Remixer" path="packages/apps/Remixer" remote="rr" />
  <project name="packages_apps_Stitch" path="packages/apps/Stitch" remote="rr" />
  <project name="packages_services_OmniJaws" path="packages/services/OmniJaws" remote="rr" />
  <project name="frameworks_opt_slimrecent" path="frameworks/opt/slimrecent" remote="rr" />
  <project name="vendor_extras" path="vendor/extras" remote="rr" />

  <!-- salami: sm8550-common lists it as a Soong namespace. -->
  <project name="LineageOS/android_hardware_pixelworks_interfaces" path="hardware/pixelworks/interfaces" />

  <!-- From VoltageOS, unchanged. Mirrored so a VoltageOS update can't break Launcher3. -->
  <project name="packages_apps_LMOFreeform" path="packages/apps/LMOFreeform" remote="rr" />

</manifest>
