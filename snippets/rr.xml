  <remove-project name="LineageOS/android_packages_apps_Launcher3" path="packages/apps/Launcher3" />
  <remove-project name="LineageOS/android_packages_apps_LineageParts" path="packages/apps/LineageParts" />
  <remove-project name="LineageOS/android_packages_apps_Settings" path="packages/apps/Settings" />
  <remove-project name="LineageOS/android_packages_apps_SetupWizard" path="packages/apps/SetupWizard" />
  <remove-project name="LineageOS/android_packages_apps_Updater" path="packages/apps/Updater" />
  <remove-project name="LineageOS/android_packages_overlays_Lineage" path="packages/overlays/Lineage" />

  <!-- Manifest (mirror) -->
  <project name="manifest" path="manifest" remote="rr" />

  <!-- Platform -->
  <project name="art" path="art" remote="rr" groups="pdk" />
  <project name="bionic" path="bionic" remote="rr" groups="pdk" />
  <project name="bootable_recovery" path="bootable/recovery" remote="rr" groups="pdk" />
  <project name="build_make" path="build/make" remote="rr" groups="pdk,sysui-studio">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project name="build_soong" path="build/soong" remote="rr" groups="pdk,tradefed,sysui-studio" />
  <project name="device_google_car" path="device/google_car" remote="rr" groups="device,pdk" />
  <project name="device_lineage_sepolicy" path="device/lineage/sepolicy" remote="rr" />
  <project name="frameworks_av" path="frameworks/av" remote="rr" groups="pdk,sysui-studio" />
  <project name="frameworks_base" path="frameworks/base" remote="rr"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" />
  <project name="frameworks_libs_systemui" path="frameworks/libs/systemui" remote="rr"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" />
